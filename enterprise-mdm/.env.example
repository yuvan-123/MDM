# Copy this file to .env and fill in real values for your environment.
# NEVER commit the resulting .env file.

# --- Application ---
APP_NAME=EnterpriseMDM
APP_ENV=local
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://mdm:mdm@localhost:5432/enterprise_mdm

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (Phase 2) ---
# Generate a strong random value for real environments, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_INSECURE_LOCAL_ONLY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Cookies (Phase 15: COOKIE_SECURE must be true in production) ---
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- CSRF ---
CSRF_SECRET=CHANGE_ME_CSRF_SECRET_LOCAL_ONLY

# --- Remote device commands / real provider integration (Phase 6/9/11) ---
# "mock" (default): every command/enrollment is simulated, no real device
# or network call ever happens. "real": requires the Android/Apple
# credentials below.
PLATFORM_PROVIDER_MODE=mock

# Android Management API — only read when PLATFORM_PROVIDER_MODE=real.
# ANDROID_SERVICE_ACCOUNT_JSON is the full service-account key JSON as a
# single-line string. ANDROID_ENTERPRISE_ID is the bound Android
# Enterprise's ID (e.g. "LC0123abcd", from the enterprises.create response).
ANDROID_SERVICE_ACCOUNT_JSON=
ANDROID_ENTERPRISE_ID=

# Shared token appended to the Pub/Sub push subscription's endpoint URL,
# e.g. https://your-public-url/api/v1/webhooks/android/pubsub?token=THIS_VALUE
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANDROID_PUBSUB_VERIFICATION_TOKEN=

# Apple MDM / APNs — only read when PLATFORM_PROVIDER_MODE=real.
APPLE_APNS_KEY_PATH=
APPLE_APNS_KEY_ID=
APPLE_APNS_TEAM_ID=
APPLE_APNS_TOPIC=

# --- Object storage (Phase 11, reports/exports) ---
STORAGE_BUCKET=
STORAGE_REGION=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
